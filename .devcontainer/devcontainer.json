{
  name: "Scalable Ecommerce Platform",
  image: "ubuntu:latest",
  customizations: {
    // Configure JetBrains IDE-specific properties
    jetbrains: {
      backend: "IntelliJ",
      settings: {
        // IDE settings can be added via “Show context actions”|“Add currently modified settings from IDE”.
        // A complete list of supported settings is also available through auto-completion
      },
      plugins: [
        // "com.intellij.ml.llm",
        "dev.sweep.assistant.cloud",
        "com.mallowigi",
        "com.haulmont.jpab",
        "dev.turingcomplete.intellijdevelopertoolsplugins",
        "EclipseCodeFormatter",
        "com.samvtran.plugins.macosforallkeymap",
        "com.chylex.intellij.inspectionlens",
        "com.intellij.plugins.monokai.colorscheme",
        "GrepConsole",
      ]
    }
  },
  features: {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": false,
    },
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/roul/devcontainer-features/mise-java:1": {
      "version": "25"
    }
  },
  "postCreateCommand": "npm i -g opencode-ai",
  // Comment out to connect as the root user.
  remoteUser: "ubuntu"
}